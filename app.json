{
  "expo": {
    "name": "LibreAuth",
    "slug": "libreauth",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "libreauth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0a1b34",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1b34"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dani47.libreauth"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a1b34",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "package": "com.dani47.libreauth",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a1b34",
          "dark": {
            "backgroundColor": "#0a1b34"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LibreAuth needs access to the camera to scan QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba161f70-1c19-4c3e-a7a5-729c67b2b0e8"
      }
    }
  }
}
